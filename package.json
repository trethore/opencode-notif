{
  "name": "opencode-notif",
  "version": "1.0.0",
  "description": "OpenCode plugin for desktop notifications",
  "main": "src/notif.ts",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "deploy": "tsx deploy.ts",
    "deploy:build": "tsx deploy.ts --build-only",
    "deploy:install": "tsx deploy.ts --install-only",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "sync:opencode": "tsx scripts/sync-opencode.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "notifications",
    "desktop"
  ],
  "author": "trethore",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
